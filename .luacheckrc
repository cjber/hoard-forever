std = "lua51"
max_line_length = 120
exclude_files = {
	"tools/.cache/**",
	".release/**",
	".types/**",
	"types/**",
	".claude/**",
	"reference/**",
	".bugpatrol/runs/**",
	".speedpatrol/runs/**",
	".sloppatrol/runs/**",
}
ignore = { "212/_.*" } -- unused arguments prefixed with _
globals = {
	"HoardForever",
	"HoardForeverDB",
	"HoardForever_OnAddonCompartmentClick",
	"SLASH_HOARDFOREVER1",
	"SLASH_HOARDFOREVER2",
	"SlashCmdList",
}
